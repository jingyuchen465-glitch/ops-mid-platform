# Copy this file to .env on the server and replace every placeholder.
MYSQL_DATABASE=ops_mid_platform
MYSQL_USER=ops
MYSQL_PASSWORD=replace-with-a-long-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
REDIS_PASSWORD=replace-with-a-long-redis-password
REDIS_DATABASE=0
BEAR_ADMIN_JWT_SECRET=replace-with-at-least-64-random-characters
BEAR_ADMIN_DATA_SECRET=replace-with-a-different-64-character-secret

# Set these to the immutable tags published by Jenkins.
BACKEND_IMAGE=registry.example.com/ops-mid-platform-backend:latest
FRONTEND_IMAGE=registry.example.com/ops-mid-platform-frontend:latest
HTTP_PORT=80

# Optional TOS settings.
BEAR_TOS_ENDPOINT=
BEAR_TOS_REGION=
BEAR_TOS_BUCKET=
BEAR_TOS_ACCESS_KEY=
BEAR_TOS_SECRET_KEY=

