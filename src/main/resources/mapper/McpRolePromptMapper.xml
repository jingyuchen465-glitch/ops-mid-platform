<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ops.midplatform.core.mapper.McpRolePromptMapper">
    <select id="findByRoleCodes" resultType="com.ops.midplatform.core.entity.McpRolePromptEntity">
        SELECT id, role_code, prompt_name, create_time
        FROM mcp_role_prompt
        WHERE role_code IN
        <foreach collection="roleCodes" item="roleCode" open="(" separator="," close=")">
            #{roleCode}
        </foreach>
        ORDER BY id ASC
    </select>
    <select id="findAll" resultType="com.ops.midplatform.core.entity.McpRolePromptEntity">
        SELECT id, role_code, prompt_name, create_time FROM mcp_role_prompt ORDER BY id DESC
    </select>
    <delete id="deleteByRoleCode">DELETE FROM mcp_role_prompt WHERE role_code=#{roleCode}</delete>
    <insert id="insert" parameterType="com.ops.midplatform.core.entity.McpRolePromptEntity">
        INSERT INTO mcp_role_prompt (role_code, prompt_name) VALUES (#{roleCode}, #{promptName})
    </insert>
</mapper>
