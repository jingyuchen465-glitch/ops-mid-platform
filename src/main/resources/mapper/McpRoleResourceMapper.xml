<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ops.midplatform.core.mapper.McpRoleResourceMapper">
    <select id="findByRoleCodes" resultType="com.ops.midplatform.core.entity.McpRoleResourceEntity">
        SELECT id, role_code, resource_uri, create_time
        FROM mcp_role_resource
        WHERE role_code IN
        <foreach collection="roleCodes" item="roleCode" open="(" separator="," close=")">
            #{roleCode}
        </foreach>
        ORDER BY id ASC
    </select>
    <select id="findAll" resultType="com.ops.midplatform.core.entity.McpRoleResourceEntity">
        SELECT id, role_code, resource_uri, create_time FROM mcp_role_resource ORDER BY id DESC
    </select>
    <delete id="deleteByRoleCode">DELETE FROM mcp_role_resource WHERE role_code=#{roleCode}</delete>
    <insert id="insert" parameterType="com.ops.midplatform.core.entity.McpRoleResourceEntity">
        INSERT INTO mcp_role_resource (role_code, resource_uri) VALUES (#{roleCode}, #{resourceUri})
    </insert>
</mapper>
